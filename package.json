{
  "name": "brody",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ALLOWED_HOSTS=${ALLOWED_HOSTS-brody} next dev -p ${PORT:-3003}",
    "build": "next build && node tools/build-worker.mjs",
    "build:worker": "node tools/build-worker.mjs",
    "start": "ALLOWED_HOSTS=${ALLOWED_HOSTS-brody} next start -p ${PORT:-3003}",
    "lint": "eslint src tests e2e scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "worker": "tsx scripts/worker.mts",
    "analyze": "tsx scripts/analyze.mts",
    "verify:ai": "tsx --env-file=.env scripts/verify-ai.mts",
    "db:generate": "drizzle-kit generate",
    "benchmark": "tsx scripts/benchmark.mts",
    "validate": "bash scripts/validate.sh",
    "convert": "tsx scripts/convert.mts",
    "brody": "bash scripts/brody.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@dagrejs/dagre": "^3.1.1",
    "@typescript-eslint/parser": "^8.70.0",
    "@xyflow/react": "^12.11.6",
    "better-sqlite3": "^13.0.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9",
    "fflate": "^0.8.3",
    "ignore": "^7.0.9",
    "isbinaryfile": "^6.0.0",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "next": "16.3.5",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.27.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "eslint-config-next": "16.3.5",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  },
  "description": "Repository intelligence, code review and code mapping",
  "engines": {
    "node": ">=24"
  }
}
