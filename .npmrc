# No dependency needs its install script: better-sqlite3 and the tree-sitter grammars ship prebuilt binaries for every
# platform (and Brody loads the grammars as WASM), and esbuild and resvg resolve their platform packages at run time.
# Running the scripts only compiles native code from source, which fails without a C++ toolchain (Windows without
# Visual Studio, slim Linux images) and on linux/arm64 for some grammars. This makes installs identical on every OS and
# every npm version. Brody's own package.json has no pre/post scripts, so nothing else is affected.
ignore-scripts=true
