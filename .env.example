# ---------- AI provider (optional; deterministic analysis works without it) ----------
# AI_PROVIDER: auto | anthropic | openai-compatible | none
# auto uses Anthropic if ANTHROPIC_API_KEY is set, otherwise OpenAI. You can also switch provider and model
# at any time from the "AI settings" panel on the home page (no restart needed); that choice wins over this file.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
# Only needed when the key is not scoped to a single workspace (sent as the anthropic-workspace-id header).
# Value looks like wrkspc_...; find it in Console > Settings > Workspaces. Alternatively create the API key
# inside a workspace (Console > Settings > API keys, pick the workspace) and leave this empty.
ANTHROPIC_WORKSPACE_ID=
# Default models used until you pick one in AI settings. Leave unset to use the built-in defaults
# (Anthropic: claude-opus-5, OpenAI: gpt-4.1). Each provider has its own variable so IDs are never mixed up.
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4.1
# Server-side fallback if the model declines a request (Fable/Opus 5 models): on | off
AI_REFUSAL_FALLBACKS=on
# OpenAI-compatible endpoints (OpenAI, vLLM, Ollama, gateways)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional semantic retrieval (OpenAI-compatible embeddings endpoint)
AI_EMBEDDING_MODEL=
# Cost estimates use built-in Anthropic and OpenAI list prices. Override or add rates (USD per 1M tokens), e.g. for a
# gateway or a self-hosted model, which otherwise shows tokens with "cost n/a":
# AI_PRICING={"llama3:70b":{"input":0.5,"output":1},"claude-opus-5":{"input":4,"output":20,"cachedInput":0.4}}
AI_CONCURRENCY=3
AI_MAX_FILES_REVIEWED=60
AI_MAX_FILES_EXPLAINED=80
AI_MAX_SYMBOLS_EXPLAINED=160

# ---------- GitHub ----------
# Optional server-wide token for private repositories / higher rate limits. Users can also paste a token per import.
GITHUB_TOKEN=
# Encrypts stored per-project GitHub tokens so they survive restarts. Without it tokens are session-scoped (memory only).
CREDENTIAL_SECRET=

# ---------- Storage and limits ----------
DATABASE_PATH=./data/brody.db
MAX_FILES=20000
MAX_TOTAL_BYTES=314572800
MAX_FILE_BYTES=2097152
MAX_UPLOAD_BYTES=209715200
MAX_ZIP_ENTRIES=50000
MAX_ZIP_RATIO=200

# ---------- Static analysis ----------
# off disables ESLint/TypeScript/Ruff/Python/gofmt checks (built-in pattern rules still run)
STATIC_ANALYSIS=on

# Parsing (and the per-file TypeScript and ESLint checks) runs on worker threads. PARSE_WORKERS=0 keeps everything on the main thread.
# Unset, it uses spare cores (max 4) that fit in memory: each worker needs about 300 MB. Repositories with fewer than
# PARSE_WORKER_MIN_FILES files to parse stay in-process, because starting workers takes about a second.
# PARSE_WORKERS=4
# PARSE_WORKER_MIN_FILES=400
RUFF_PATH=ruff
PYTHON_PATH=python3

# ---------- Formal verification (Lean 4) ----------
# The most complex, riskiest functions are modelled in Lean by the AI provider; the Lean kernel proves properties about
# them or proves a concrete counterexample. Needs an AI provider and a Lean 4 toolchain:
#   curl https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh -sSf | sh -s -- -y --default-toolchain stable
# Brody finds `lean` on PATH or in ~/.elan/bin (the Docker image ships it and sets LEAN_BIN=/opt/lean/bin/lean).
# Set LEAN_BIN to use another binary (not LEAN_PATH: Lean reads that itself).
FORMAL_VERIFICATION=on
# LEAN_BIN=/opt/lean/bin/lean
# Functions modelled per analysis, repair rounds fed with Lean's errors (complex code gets more), Lean processes at once
FORMAL_MAX_TARGETS=10
FORMAL_MAX_REPAIR_ROUNDS=3
FORMAL_CONCURRENCY=2
# Per check: wall-clock limit, memory cap and Lean's own work limit
FORMAL_TIMEOUT_MS=60000
FORMAL_MEMORY_MB=2048
FORMAL_MAX_HEARTBEATS=400000
# Optional isolation wrapper put in front of every Lean check (Linux), for example:
# FORMAL_SANDBOX=bwrap --ro-bind / / --bind /tmp /tmp --dev /dev --unshare-net --die-with-parent

# ---------- Runtime ----------
# Set to off to run the worker as a separate process (npm run worker) instead of inside the web server
EMBEDDED_WORKER=on

# Port and the only hostname the app answers to (comma separated). Empty disables the host check.
PORT=3003
ALLOWED_HOSTS=brody
