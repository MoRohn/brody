# ---------- AI provider (optional; deterministic analysis works without it) ----------
# AI_PROVIDER: auto | anthropic | openai-compatible | none
# auto uses Anthropic if ANTHROPIC_API_KEY is set, otherwise OpenAI. You can also switch provider and model
# at any time from the "AI settings" panel on the home page (no restart needed); that choice wins over this file.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
# Only needed when the key is not scoped to a single workspace (sent as the anthropic-workspace-id header).
# Value looks like wrkspc_...; find it in Console > Settings > Workspaces. Alternatively create the API key
# inside a workspace (Console > Settings > API keys, pick the workspace) and leave this empty.
ANTHROPIC_WORKSPACE_ID=
# Default models used until you pick one in AI settings. Leave unset to use the built-in defaults
# (Anthropic: claude-opus-5, OpenAI: gpt-4.1). Each provider has its own variable so IDs are never mixed up.
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4.1
# Server-side fallback if the model declines a request (Fable/Opus 5 models): on | off
AI_REFUSAL_FALLBACKS=on
# OpenAI-compatible endpoints (OpenAI, vLLM, Ollama, gateways)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional semantic retrieval (OpenAI-compatible embeddings endpoint)
AI_EMBEDDING_MODEL=
AI_CONCURRENCY=3
AI_MAX_FILES_REVIEWED=60
AI_MAX_FILES_EXPLAINED=80
AI_MAX_SYMBOLS_EXPLAINED=160

# ---------- GitHub ----------
# Optional server-wide token for private repositories / higher rate limits. Users can also paste a token per import.
GITHUB_TOKEN=
# Encrypts stored per-project GitHub tokens so they survive restarts. Without it tokens are session-scoped (memory only).
CREDENTIAL_SECRET=

# ---------- Storage and limits ----------
DATABASE_PATH=./data/brody.db
MAX_FILES=20000
MAX_TOTAL_BYTES=314572800
MAX_FILE_BYTES=2097152
MAX_UPLOAD_BYTES=209715200
MAX_ZIP_ENTRIES=50000
MAX_ZIP_RATIO=200

# ---------- Static analysis ----------
# off disables ESLint/TypeScript/Ruff/Python/gofmt checks (built-in pattern rules still run)
STATIC_ANALYSIS=on
RUFF_PATH=ruff
PYTHON_PATH=python3

# ---------- Runtime ----------
# Set to off to run the worker as a separate process (npm run worker) instead of inside the web server
EMBEDDED_WORKER=on

# Port and the only hostname the app answers to (comma separated). Empty disables the host check.
PORT=3003
ALLOWED_HOSTS=brody
